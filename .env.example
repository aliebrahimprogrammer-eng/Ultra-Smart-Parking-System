# Atlas connection string, with your real password in place of the placeholder
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/

# Must be valid base64 and at least 32 characters. Letters and numbers only is safest.
JWT_SECRET=replace_with_a_long_random_string_of_letters_and_numbers

JWT_EXPIRATION_MS=86400000

# Optional: creates this admin account the first time auth-service starts
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_me
